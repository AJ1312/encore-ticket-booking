# ── Database ────────────────────────────────────────────────────────
# PostgreSQL Connection URL (Neon, Render, Supabase, or Local)
DATABASE_URL="postgresql://encore:replace-with-a-long-local-password@localhost:5432/encore"
POSTGRES_USER="encore"
POSTGRES_PASSWORD="replace-with-a-long-local-password"
POSTGRES_DB="encore"

# ── Authentication ──────────────────────────────────────────────────
# 32+ character secure secret for Better Auth
BETTER_AUTH_SECRET="your-super-secret-auth-key-minimum-32-chars!!"
BETTER_AUTH_URL="http://localhost:4000"
SEED_PASSWORD="SeedPassword123!"

# ── Environment ─────────────────────────────────────────────────────
# production or development
NODE_ENV="development"
PORT=4000

# ── Frontend Sync ───────────────────────────────────────────────────
# URL of your frontend application to allow CORS requests
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Background Worker & Cache ───────────────────────────────────────
# Redis is required for BullMQ and the Waitlist system
REDIS_URL="redis://localhost:6379"

# ── Email Dispatch (Optional) ───────────────────────────────────────
# Resend API key for dispatching confirmation emails and waitlist offers
RESEND_API_KEY="re_..."
FROM_EMAIL="Encore Tickets <tickets@yourdomain.com>"

# ── Cloudflare Turnstile (Bot Protection) ────────────────────────────
# Site key (public) — used by the Next.js frontend widget
# Already embedded in the frontend. Set this if you ever rotate the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAEb2pV-sOTXXLdIU"

# Secret key (private) — used by the API for server-side siteverify
# Get from: Cloudflare Dashboard → Turnstile → your widget → Secret Key
# Add to: Render dashboard (API service) + keep out of git
TURNSTILE_SECRET="<your-turnstile-secret-key>"

# Comma-separated list of production frontend hostnames Turnstile tokens
# are allowed to originate from. Must NOT include localhost in production.
# Example: TURNSTILE_HOSTNAMES="encore.yourdomain.com"
TURNSTILE_HOSTNAMES=""
